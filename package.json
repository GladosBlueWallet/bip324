{
  "name": "bip324",
  "version": "0.0.1",
  "description": "Isomorphic BIP-324 Bitcoin P2P transport and typed v2 message codec",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/react-native.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "example:getaddr": "bun examples/signet-getaddr.ts",
    "example:mainnet": "bun examples/mainnet-fetch-block.ts",
    "test": "bun test",
    "test:package": "bun tests/packaging/import.mjs",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run test:package",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/btc-signer": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
