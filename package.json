{
  "name": "bip324",
  "version": "0.0.1",
  "description": "Isomorphic BIP-324 Bitcoin P2P transport and typed v2 message codec",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/react-native.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm --dts --clean --sourcemap && tsup --config tsup.react-native.config.ts",
    "example:getaddr": "bun examples/signet-getaddr.ts",
    "example:mainnet": "bun examples/mainnet-fetch-block.ts",
    "test": "bun test",
    "test:package": "bun run build && node tests/packaging/import.mjs",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run test:package",
    "prepare": "npm run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/btc-signer": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
